{
  "name": "collabo",
  "version": "0.1.0",
  "description": "COLLABO — Institution-Oriented Collaborative Learning Platform",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @collabo/web dev",
    "dev:all": "pnpm --parallel --filter @collabo/* dev",
    "dev:realtime": "pnpm --filter @collabo/realtime dev",
    "build": "pnpm --filter @collabo/web build",
    "test": "npx --prefix apps/realtime tsx scripts/run-all-tests.ts",
    "test:unit": "npx --prefix apps/realtime tsx scripts/test-unit-integration.ts",
    "test:load": "npx --prefix apps/realtime tsx scripts/load-test-control-plane.ts",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
