# COLLABO — Environment Configuration Template
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Milestone 6: Supabase PostgreSQL Database Persistence
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API to copy your Project URL and anon public key
# 3. In the Supabase SQL Editor, run the migration in supabase/migrations/20261030000001_create_boards_table.sql
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder
# Optional: SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-server-routes

# ------------------------------------------------------------------------------
# Future services (introduced in Step 7 - do NOT add real keys here)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:4000
