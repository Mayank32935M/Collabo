# env files
.env*.local
.env
.env.production
.env.development
.env.test
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs and editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS files
Thumbs.db
[Dd]esktop.ini
